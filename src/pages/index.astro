        var budgetContainer = document.getElementById('diag-budget-container');
        var inputNome = document.getElementById('diag-input-nome');
        var inputWhatsapp = document.getElementById('diag-input-whatsapp');
        var navRow = document.getElementById('diag-nav-row');
        var successPanel = document.getElementById('diag-success-panel');
        var successWhatsappBtn = document.getElementById('diag-success-whatsapp-btn');

        // Elementos HUD
        var hudObjetivo = document.getElementById('hud-val-objetivo');
        var hudCredito = document.getElementById('hud-val-credito');
        var hudEstrategia = document.getElementById('hud-val-estrategia');
        var hudLance = document.getElementById('hud-val-lance');
        var hudIndexador = document.getElementById('hud-val-indexador');
        var hudParceiras = document.getElementById('hud-val-parceiras');

        if (!stepIndicator || !btnNext) return;

        // Renderiza Tiers de Crédito do Passo 2
        function renderTiers() {
          var list = tierData[state.objetivo] || tierData.imoveis;
          tierContainer.innerHTML = '';
          list.forEach(function (item, idx) {
            var btn = document.createElement('div');
            btn.className = 'diag-tier-btn' + (idx === 1 ? ' selected' : '');
            btn.setAttribute('data-val', item.val);
            btn.innerHTML = '<span class="tier-val">' + item.val + '</span><span class="tier-sub">' + item.sub + '</span>';
            btn.addEventListener('click', function () {
              var all = tierContainer.querySelectorAll('.diag-tier-btn');
              all.forEach(function (b) { b.classList.remove('selected'); });
              btn.classList.add('selected');
              state.credito = item.val;
              updateHud();
            });
            tierContainer.appendChild(btn);
          });
          state.credito = list[1].val;
        }

        // Renderiza Faixas de Parcela do Passo 4
        function renderBudgets() {
          var list = budgetData[state.objetivo] || budgetData.imoveis;
          budgetContainer.innerHTML = '';
          list.forEach(function (item, idx) {
            var pill = document.createElement('div');
            pill.className = 'diag-budget-pill' + (idx === 1 ? ' selected' : '');
            pill.setAttribute('data-val', item);
            pill.textContent = item + ' / mês';
            pill.addEventListener('click', function () {
              var all = budgetContainer.querySelectorAll('.diag-budget-pill');
              all.forEach(function (p) { p.classList.remove('selected'); });
              pill.classList.add('selected');
              state.parcela = item;
            });
            budgetContainer.appendChild(pill);
          });
          state.parcela = list[1];
        }

        // Atualização do HUD Lateral em Tempo Real
        function updateHud() {
          var objNames = {
            imoveis: 'Imóveis & Construção',
            veiculos: 'Automóveis & Motos',
            pesados: 'Pesados & Maquinário',
            patrimonio: 'Alavancagem Patrimonial'
          };
          var stratNames = {
            curto: 'Aceleração / Curto Prazo (50 a 80m)',
            medio: 'Equilíbrio / Lance Fixo (90 a 165m)',
            longo: 'Disciplina / Longo Prazo (até 240m)'
          };

          if (hudObjetivo) hudObjetivo.textContent = objNames[state.objetivo] || 'Imóveis & Construção';
          if (hudCredito) hudCredito.textContent = state.credito;
          if (hudEstrategia) hudEstrategia.textContent = stratNames[state.estrategia] || 'Aceleração / Curto Prazo';

          if (hudLance) {
            if (state.objetivo === 'imoveis') {
              hudLance.textContent = 'Até 30% da Própria Carta';
            } else if (state.objetivo === 'pesados') {
              hudLance.textContent = '25% Embutido + Plano 50%';
            } else {
              hudLance.textContent = 'Até 25% da Própria Carta';
            }
          }

          if (hudIndexador) {
            if (state.objetivo === 'imoveis') {
              hudIndexador.textContent = 'INCC (Construção Civil)';
            } else {
              hudIndexador.textContent = 'IPCA (Inflação Oficial)';
            }
          }

          if (hudParceiras) {
            hudParceiras.textContent = 'Embracon · CNVW';
          }
        }

        // Formatação Automática de WhatsApp com Máscara
        if (inputWhatsapp) {
          inputWhatsapp.addEventListener('input', function (e) {
            var v = e.target.value.replace(/\D/g, '');
            if (v.length > 11) v = v.substring(0, 11);
            if (v.length > 10) {
              e.target.value = '(' + v.substring(0, 2) + ') ' + v.substring(2, 7) + '-' + v.substring(7);
            } else if (v.length > 6) {
              e.target.value = '(' + v.substring(0, 2) + ') ' + v.substring(2, 6) + '-' + v.substring(6);
            } else if (v.length > 2) {
              e.target.value = '(' + v.substring(0, 2) + ') ' + v.substring(2);
            } else if (v.length > 0) {
              e.target.value = '(' + v;
            }
          });
        }

        // Helper para obter texto responsivo do botão conforme resolução
        function getNextBtnLabel(step) {
          var isMobile = window.innerWidth <= 640;
          if (step === 4) {
            return isMobile ? 'Receber Estudo no WhatsApp' : 'Receber Estudo de Viabilidade no WhatsApp';
          }
          return isMobile ? 'Continuar (Passo ' + (step + 1) + ')' : 'Continuar para Passo ' + (step + 1);
        }

        // Troca de Passo com Animação Fluida
        function goToStep(newStep) {
          if (newStep < 1 || newStep > 4) return;
          state.step = newStep;

          // Esconde todos os painéis
          for (var i = 1; i <= 4; i++) {
            var panel = document.getElementById('step-panel-' + i);
            if (panel) {
              panel.classList.remove('active');
            }
          }

          // Ativa o painel do passo atual
          var activePanel = document.getElementById('step-panel-' + state.step);
          if (activePanel) {
            activePanel.classList.add('active');
          }

          // Atualiza informações de cabeçalho
          var info = stepMetaInfo[state.step - 1];
          if (stepIndicator) stepIndicator.textContent = info.counter;
          if (stepStatus) stepStatus.textContent = info.status;
          if (stepPrompt) stepPrompt.textContent = info.prompt;
          if (stepDesc) stepDesc.textContent = info.desc;

          // Atualiza progresso da barra
          var pct = (state.step / 4) * 100;
          if (progressFill) progressFill.style.width = pct + '%';

          // Botão Voltar visibilidade
          if (btnPrev) {
            btnPrev.style.visibility = state.step === 1 ? 'hidden' : 'visible';
          }

          // Texto do Botão Avançar
          if (btnText && btnTextClone) {
            var label = getNextBtnLabel(state.step);
            btnText.textContent = label;
            btnTextClone.textContent = label;
          }

          // Se for passo 2, garante que os tiers estão renderizados para o objetivo atual
          if (state.step === 2) {
            renderTiers();
          }

          // Se for passo 4, garante que os orçamentos estão sincronizados
          if (state.step === 4) {
            renderBudgets();
          }

          updateHud();
        }

        // Listeners do Passo 1 (Cards de Objetivo)
        var objCards = document.querySelectorAll('.diag-choice-card[data-target="step-1"]');
        objCards.forEach(function (card) {
          card.addEventListener('click', function () {
            objCards.forEach(function (c) { c.classList.remove('selected'); });
            card.classList.add('selected');
            state.objetivo = card.getAttribute('data-value');
            renderTiers();
            renderBudgets();
            updateHud();
          });
        });

        // Listeners do Passo 3 (Estratégias)
        var stratCards = document.querySelectorAll('.diag-strategy-card[data-target="step-3"]');
        stratCards.forEach(function (card) {
          card.addEventListener('click', function () {
            stratCards.forEach(function (c) { c.classList.remove('selected'); });
            card.classList.add('selected');
            state.estrategia = card.getAttribute('data-value');
            updateHud();
          });
        });

        // Clique no Botão Voltar
        if (btnPrev) {
          btnPrev.addEventListener('click', function () {
            goToStep(state.step - 1);
          });
        }

        // Clique no Botão Avançar / Enviar
        if (btnNext) {
          btnNext.addEventListener('click', function () {
            if (state.step < 4) {
              goToStep(state.step + 1);
            } else {
              // Validação do Passo 4
              var nome = (inputNome ? inputNome.value.trim() : '');
              var wpp = (inputWhatsapp ? inputWhatsapp.value.trim() : '');

              if (!nome) {
                if (inputNome) {
                  inputNome.focus();
                  inputNome.style.boxShadow = 'inset 0 0 0 1px #F87171, 0 0 0 3px rgba(248, 113, 113, 0.25)';
                  setTimeout(function () { inputNome.style.boxShadow = ''; }, 2500);
                }
                return;
              }

              if (!wpp || wpp.replace(/\D/g, '').length < 10) {
                if (inputWhatsapp) {
                  inputWhatsapp.focus();
                  inputWhatsapp.style.boxShadow = 'inset 0 0 0 1px #F87171, 0 0 0 3px rgba(248, 113, 113, 0.25)';
                  setTimeout(function () { inputWhatsapp.style.boxShadow = ''; }, 2500);
                }
                return;
              }

              state.nome = nome;
              state.whatsapp = wpp;

              // Monta a mensagem personalizada do WhatsApp
              var objNames = {
                imoveis: 'Imóveis & Construção',
                veiculos: 'Automóveis & Motos',
                pesados: 'Pesados & Maquinário',
                patrimonio: 'Alavancagem Patrimonial'
              };
              var stratNames = {
                curto: 'Aceleração / Curto Prazo (50 a 80m)',
                medio: 'Equilíbrio / Lance Fixo (90 a 165m)',
                longo: 'Disciplina / Longo Prazo (até 240m)'
              };

              var msg = 'Olá, Rafael! Fiz o diagnóstico guiado no site da Lifecon e gostaria de receber meu estudo de viabilidade:\n\n' +
                '• Nome: ' + state.nome + '\n' +
                '• Objetivo: ' + (objNames[state.objetivo] || state.objetivo) + '\n' +
                '• Faixa de Crédito: ' + state.credito + '\n' +
                '• Estratégia de Contemplação: ' + (stratNames[state.estrategia] || state.estrategia) + '\n' +
                '• Parcela Confortável: ' + state.parcela + '\n' +
                '• WhatsApp: ' + state.whatsapp + '\n\n' +
                'Aguardo o comparativo das administradoras homologadas. Obrigado!';

              var waUrl = 'https://wa.me/5521972838954?text=' + encodeURIComponent(msg);

              // Transição para Tela de Sucesso
              for (var k = 1; k <= 4; k++) {
                var p = document.getElementById('step-panel-' + k);
                if (p) p.style.display = 'none';
              }
              if (navRow) navRow.style.display = 'none';
              if (stepIndicator) stepIndicator.textContent = 'CONCLUÍDO';
              if (stepStatus) stepStatus.textContent = 'ESTUDO GERADO COM SUCESSO';
              if (stepPrompt) stepPrompt.textContent = 'Seu planejamento foi traçado com sucesso!';
              if (stepDesc) stepDesc.textContent = 'Clique abaixo para abrir sua conversa direta com nossa equipe no WhatsApp.';
              if (progressFill) progressFill.style.width = '100%';

              if (successPanel) {
                successPanel.classList.add('active');
              }
              if (successWhatsappBtn) {
                successWhatsappBtn.href = waUrl;
              }

              // Abre WhatsApp
              window.open(waUrl, '_blank');
            }
          });
        }

        // Inicialização dos Tiers e HUD
        renderTiers();
        renderBudgets();
        updateHud();

        if (btnText && btnTextClone) {
          var initialLabel = getNextBtnLabel(state.step);
          btnText.textContent = initialLabel;
          btnTextClone.textContent = initialLabel;
        }

        window.addEventListener('resize', function () {
          if (btnText && btnTextClone) {
            var label = getNextBtnLabel(state.step);
            btnText.textContent = label;
            btnTextClone.textContent = label;
          }
        });
      }

      // ================= GERENCIAMENTO DO FAQ / CENTRAL DE CLAREZA =================
      function setupFaqAccordion() {
        var faqItems = document.querySelectorAll('.faq-item');
        var filterBtns = document.querySelectorAll('.faq-filter-btn');

        // 1. Toggling dos Accordions com Acessibilidade e Transição Suave
        faqItems.forEach(function (item) {
          var trigger = item.querySelector('.faq-trigger');
          if (!trigger) return;

          trigger.addEventListener('click', function () {
            var isActive = item.classList.contains('active');
            
            // Fecha os outros para manter a tela limpa e focada (estilo Apple/Aural)
            faqItems.forEach(function (other) {
              if (other !== item) {
                other.classList.remove('active');
                var otherTrigger = other.querySelector('.faq-trigger');
                if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
              }
            });

            if (isActive) {
              item.classList.remove('active');
              trigger.setAttribute('aria-expanded', 'false');
            } else {
              item.classList.add('active');
              trigger.setAttribute('aria-expanded', 'true');
            }

            // Atualiza posições de ScrollTrigger do GSAP
            if (typeof ScrollTrigger !== 'undefined') {
              ScrollTrigger.refresh();
            }
          });
        });

        // 2. Filtro por Categoria (Todas, Lances, Custos, Segurança)
        filterBtns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var cat = btn.getAttribute('data-filter');

            filterBtns.forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');

            faqItems.forEach(function (item) {
              var itemCat = item.getAttribute('data-cat');
              if (cat === 'all' || itemCat === cat) {
                item.style.display = 'block';
                // Efeito suave de entrada
                if (typeof gsap !== 'undefined') {
                  gsap.fromTo(item, { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' });
                }
              } else {
                item.style.display = 'none';
              }
            });

            if (typeof ScrollTrigger !== 'undefined') {
              ScrollTrigger.refresh();
            }
          });
        });
      }

      function initApp() {
        if (!canvas) {
          canvas = document.getElementById('hero-canvas');
          if (canvas) ctx = canvas.getContext('2d', { alpha: false });
        }
        if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
          gsap.registerPlugin(ScrollTrigger);
        }
        preloadFrames();
        resizeCanvas();
        playEntranceAnimation();
        setupScrollytelling();
        setupBlurScrollAnimations();
        setupSpotlightTracking();
        setupDiagnosticConsole();
        setupFaqAccordion();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }
      document.addEventListener('astro:page-load', initApp);

      // Redimensionamento Inteligente (ignora retração/expansão da barra de navegação no mobile)
      var lastWidth = window.innerWidth;
      window.addEventListener('resize', function () {
        if (Math.abs(window.innerWidth - lastWidth) > 60) {
          var newIsMobile = window.innerWidth < 992;
          if (newIsMobile !== isMobile) {
            isMobile = newIsMobile;
            framesPath = isMobile ? '/assets/frames-mobile/' : '/assets/frames-desktop/';
            preloadFrames();
          }
          lastWidth = window.innerWidth;
          resizeCanvas();
          if (typeof ScrollTrigger !== 'undefined') {
            ScrollTrigger.refresh();
          }
        }
      });

    })();
  </script>

