---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SolutionCard from '../components/SolutionCard.astro';
import ContrastCard from '../components/ContrastCard.astro';
---

<Layout>
<!-- ================= HERO SECTION FULL-SCREEN COM APPLE-GRADE SCROLLYTELLING ================= -->
  <section id="hero-scroll-wrapper">
    <div class="hero-pinned-stage" id="hero-pin-target">
      
      <!-- Canvas de Alta Performance Apple-Grade (120 WebP Frames GPU Accelerated) -->
      <div class="hero-video-fullscreen">
        <canvas id="hero-canvas"></canvas>
      </div>

      <!-- Orbit Background Geometry (Padrão DRIFT & OTTO) -->
      <div class="hero-orbit-stage" aria-hidden="true">
        <svg class="hero-orbit-svg" viewBox="0 0 500 500" fill="none">
          <circle cx="250" cy="250" r="230" stroke="rgba(9, 175, 198, 0.12)" stroke-width="1" stroke-dasharray="4 6" />
          <circle cx="250" cy="250" r="170" stroke="rgba(202, 157, 99, 0.15)" stroke-width="1" />
          <circle cx="250" cy="250" r="110" stroke="rgba(9, 175, 198, 0.20)" stroke-width="1" stroke-dasharray="2 4" />
          <line x1="250" y1="10" x2="250" y2="490" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" stroke-dasharray="2 8" />
          <line x1="10" y1="250" x2="490" y2="250" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" stroke-dasharray="2 8" />
          <circle cx="250" cy="20" r="3" fill="#09AFC6" />
          <circle cx="420" cy="250" r="3" fill="#CA9D63" />
        </svg>
      </div>

      <!-- Scrim Gradiente Dinâmico (Fade out no scroll junto com o texto) -->
      <div class="hero-scrim-overlay" id="hero-scrim"></div>

      <!-- Floating Contextual Cards (Padrão OTTO - preenche o espaço com prova de alto valor) -->
      <div class="hero-float-badges" id="hero-float-badges">
        <div class="hero-float-card float-card-left">
          <span class="float-card-dot"></span>
          <div class="float-card-body">
            <span class="float-card-label">Administradoras Oficiais</span>
            <span class="float-card-val">Embracon · CNVW</span>
          </div>
        </div>
        <div class="hero-float-card float-card-right">
          <span class="float-card-dot gold-dot"></span>
          <div class="float-card-body">
            <span class="float-card-label">Alavancagem Inteligente</span>
            <span class="float-card-val">Lance Embutido até 30%</span>
          </div>
        </div>
      </div>

      <!-- Camada de Texto & Copywriting (Some suavemente nos primeiros 20% do scroll) -->
      <div class="hero-text-layer" id="hero-text-layer">
        <div class="hero-content">
          
          <!-- Eyebrow Badge -->
          <div class="hero-badge hero-anim-elem">
            <span class="hero-badge-dot"></span>
            <span>Assessoria Patrimonial & Consórcios</span>
          </div>

          <!-- Headline H1 com Destaque Dourado -->
          <h1 class="hero-title hero-anim-elem">
            <span class="hero-title-main">Antes de vender um plano,</span>
            <span class="hero-title-accent"><em>queremos entender o seu.</em></span>
          </h1>

          <!-- Subtítulo de Autoridade -->
          <p class="hero-subtitle hero-anim-elem">
            A estratégia inteligente para conquistar imóveis, veículos e patrimônio sólido com transparência absoluta e assessoria do início ao fim.
          </p>

          <!-- Ação Primária & Secundária (Desktop side-by-side / Mobile focado) -->
          <div class="hero-actions hero-anim-elem">
            <Button
              href="#diagnostico"
              class="hero-btn-primary"
              id="hero-primary-cta"
              text="Traçar Meu Planejamento"
            />
            
            <Button
              href="#como-funciona"
              variant="ghost"
              class="hero-btn-secondary"
              id="hero-secondary-cta"
              text="Como Funciona"
              icon="↓"
            />
          </div>

          <!-- Faixa de Confiança & Transparência Ética (100% Genuíno e Sem Mentiras) -->
          <div class="hero-trust-strip hero-anim-elem">
            <span class="trust-shield-icon">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#CA9D63" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <span class="trust-primary">Transparência Absoluta</span>
            <span class="trust-sep">·</span>
            <span class="trust-secondary">Taxas a partir de 12% total · 0% juros bancários</span>
          </div>

        </div>
      </div>

      <!-- Floating Pill de Scroll Desktop -->
      <a href="#como-funciona" class="hero-scroll-pill" id="hero-scroll-cue">
        <span class="scroll-pill-dot"></span>
        <span class="scroll-pill-text">Role para Explorar</span>
        <span class="scroll-pill-arrow">↓</span>
      </a>

      <!-- Bottom Horizon Dock Mobile (Padrão DRIFT & OTTO) -->
      <div class="hero-bottom-dock" id="hero-bottom-dock">
        <div class="dock-meta-left">
          <span class="dock-tag">LIFECON</span>
          <span class="dock-sep">/</span>
          <span class="dock-step-active">01 DIAGNÓSTICO</span>
        </div>
        <a href="#como-funciona" class="dock-scroll-cue">
          <span class="dock-cue-text">Role para Explorar</span>
          <span class="dock-cue-arrow">↓</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ================= SEÇÃO 02: AS SOLUÇÕES LIFECON & O CONTRASTE FINANCEIRO ================= -->
  <section class="sec-solutions" id="como-funciona">
    <div class="sec-container">
      
      <!-- Header Editorial da Seção -->
      <header class="sec-header" data-blur-scroll>
        <div class="sec-kicker">
          <span class="sec-kicker-dot"></span>
          <span>02 · ESTRUTURAÇÃO PATRIMONIAL</span>
        </div>
        <h2 class="sec-title">
          Não entregamos apenas cartas de crédito.<br>
          Estruturamos <em>caminhos viáveis</em> para o que você quer realizar.
        </h2>
        <p class="sec-subtitle">
          Conheça as três principais frentes de planejamento da Lifecon. Uma abordagem estratégica para quem busca solidez, poder de compra à vista e custo financeiro infinitamente menor.
        </p>
      </header>

      <!-- As Três Frentes Estratégicas (Grid Bento com Vidro .gb e Spotlight [data-spot]) -->
      <div class="solution-grid">
        
        <!-- Solução 1: Imóveis & Construção -->
        <SolutionCard
          id="imoveis"
          badgeNum="01 / 03"
          badgeTag="SFH & Imobiliário"
          title="Imóveis, Terrenos, Construção ou Reforma"
          description="Para quem quer sair do aluguel, adquirir um imóvel de maior padrão, construir do zero ou reformar sem comprometer o fluxo de caixa com juros bancários compostos."
          calloutLabel="Lance Embutido de até 30% + FGTS"
          calloutText="Utilize de 25% a até 30% da própria carta como oferta de lance sem desembolsar recursos próprios, além da possibilidade de uso integral do seu FGTS pelo SFH."
          specs={[
            "R$ 100k a R$ 1.2M+",
            "50 a 240 meses (até 20 anos)",
            "Taxa Adm a partir de 12% Total",
            "Opções com 0% Entrada",
            "Reajuste Oficial INCC"
          ]}
          actionText="Simular Plano Imobiliário"
          actionHref="#diagnostico"
        >
          <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#09AFC6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </SolutionCard>

        <!-- Solução 2: Veículos & Frotas -->
        <SolutionCard
          id="veiculos"
          badgeNum="02 / 03"
          badgeTag="Automotivo & Frotas"
          title="Automóveis, Motos e Renovação de Frotas"
          description="Troque de veículo no momento certo com poder de compra à vista para negociar até 15% de desconto, sem desvalorização acelerada por juros de financiamento."
          calloutLabel="0% Entrada ou Antecipada em 12x"
          calloutText="Tabelas com 0% de taxa antecipada ou entrada fracionada em até 12x (1,2%). Concorra por Lance Fixo (25% ou 50%) e Lance Embutido de 25%."
          specs={[
            "Autos: R$ 45k a R$ 180k",
            "Motos: R$ 15k a R$ 30k",
            "40 a 100 meses",
            "Taxa a partir de 13% Total",
            "Reajuste Oficial IPCA"
          ]}
          actionText="Simular Plano Veicular"
          actionHref="#diagnostico"
        >
          <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#CA9D63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.9 2 11.2 2 11.5V16c0 .6.4 1 1 1h2"/>
            <circle cx="7" cy="17" r="2"/>
            <path d="M9 17h6"/>
            <circle cx="17" cy="17" r="2"/>
          </svg>
        </SolutionCard>

        <!-- Solução 3: Alavancagem Patrimonial & Pesados -->
        <SolutionCard
          id="patrimonio"
          badgeNum="03 / 03"
          badgeTag="Pesados & Alavancagem"
          title="Caminhões, Pesados & Alavancagem"
          description="Para empresários, frotistas e investidores que utilizam o consórcio para multiplicar ativos, adquirir máquinas e caminhões com o menor custo do mercado."
          calloutLabel="Plano 50%: Pague Meia Parcela"
          calloutText="Exclusividade para pesados: pague apenas 50% da parcela até a contemplação, preservando o capital de giro da sua empresa para crescer sem dívidas caras."
          specs={[
            "Pesados: R$ 200k a R$ 700k+",
            "Prazo de 100 meses",
            "Taxa Total de 12% a 14% (~1,4% a.a.)",
            "Opções 0% Entrada",
            "Plano 50% Parcelinha"
          ]}
          actionText="Simular Alavancagem"
          actionHref="#diagnostico"
        >
          <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#A3E635" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="22"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </SolutionCard>

      </div>

      <!-- ================= O ARGUMENTO LÓGICO DE CONTRASTE FINANCEIRO ================= -->
      <div class="contrast-section">
        
        <div class="contrast-header" data-blur-scroll>
          <div class="contrast-kicker">
            <span>ANÁLISE COMPARATIVA DE CUSTO</span>
          </div>
          <h3 class="contrast-title">O Contraste Financeiro que os Bancos não Contam</h3>
          <p class="contrast-subtitle">
            Veja a diferença matemática entre comprometer anos com juros bancários compostos ou planejar sua conquista com inteligência e taxas a partir de 12% para todo o contrato.
          </p>
        </div>

        <div class="contrast-grid">
          
          <!-- Lado Negativo: Financiamento Bancário -->
          <ContrastCard
            variant="danger"
            badgeText="✕ Ineficiência de Capital"
            title="No Financiamento Bancário"
            punch="Você adquire 1 bem e no final pagou de 2 a 3 vezes o valor dele."
            metricCaption="Custo Real Final"
            metricVal="220% a 300% do valor (Você paga 2 a 3 bens)"
          >
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Juros Compostos de 10% a 14% ao Ano:</strong> Parcelas infladas que transferem sua riqueza para o banco em vez de construir seu patrimônio.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Entrada Obrigatória de 20% a 30%:</strong> Descapitalização pesada logo no início (R$ 60k a R$ 100k+), secando sua reserva de emergência.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Taxas Embutidas, TAC e Seguros:</strong> Venda casada de seguros obrigatórios e IOF encarecendo brutalmente o Custo Efetivo Total (CET).</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Amortização Lenta:</strong> O bem perde valor de mercado com o tempo enquanto o saldo devedor permanece elevado nos primeiros anos.</span>
            </li>
          </ContrastCard>

          <!-- Lado Positivo: Planejamento Lifecon -->
          <ContrastCard
            variant="positive"
            badgeText="✓ Alta Eficiência Patrimonial"
            title="No Planejamento Lifecon"
            punch="Você compra à vista com poder de negociação e taxa administrativa diluída."
            metricCaption="Custo Real Final"
            metricVal="Apenas o bem + Taxa de 12% a 18% total (Zero juros)"
          >
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Taxa Administrativa Pré-Fixada (Sem Juros):</strong> Ao contrário do financiamento, onde você paga juros compostos que dobram a dívida, no consórcio existe apenas uma taxa de administração diluída ao longo de todo o plano — gerando uma economia de até 60% no custo final do seu bem.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Opções com 0% de Entrada:</strong> Alternativas que não exigem aporte inicial à vista, preservando seu capital de giro e sua reserva financeira rendendo com segurança.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Lance Embutido de até 30% da Carta:</strong> Utilize parte da própria carta de crédito contratada como oferta de lance para acelerar sua contemplação sem desembolsar recursos próprios.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Plano 50% para Preservar o Caixa:</strong> Modalidade estratégica para frotas e pesados que permite pagar meia parcela até a contemplação, mantendo o fluxo de caixa da empresa saudável.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Poder de Compra Blindado (INCC e IPCA):</strong> O crédito reajusta anualmente para acompanhar a valorização real de mercado, assegurando seu poder de compra à vista em qualquer época.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Administradoras Líderes de Mercado:</strong> Planos estruturados através de referências nacionais consolidadas como <strong>Embracon</strong> e <strong>CNVW</strong> (Consórcio Nacional Volkswagen), associadas à ABAC e auditadas pelo Banco Central.</span>
            </li>
          </ContrastCard>

        </div>

      </div>

      <!-- Banner de Fechamento com CTA Aural Design System -->
      <div class="sec-cta-banner gb" data-spot data-blur-scroll>
        <div class="banner-text-side">
          <span class="banner-kicker">PRÓXIMO PASSO ESTRATÉGICO</span>
          <h3 class="banner-title">Pronto para transformar planos em conquistas concretas?</h3>
          <p class="banner-desc">
            Apresentamos um estudo de viabilidade gratuito e sem compromisso, cruzando as maiores administradoras do país com o seu momento financeiro.
          </p>
        </div>

        <Button href="#diagnostico" text="Quero Simular Meu Objetivo" />
      </div>

    </div>
  </section>

  <!-- ================= SEÇÃO 03: O DIAGNÓSTICO GUIADO LIFECON (A MÁQUINA DE LEADS) ================= -->
  <section class="sec-diagnostic" id="diagnostico">
    <div class="diag-container">

      <!-- Header Editorial da Seção -->
      <header class="diag-header" data-blur-scroll>
        <div class="diag-kicker">
          <span class="diag-kicker-dot"></span>
          <span>03 · CONSULTORIA DE VIABILIDADE</span>
        </div>
        <h2 class="diag-title">
          Descubra qual planejamento financeiro<br>
          <em>faz sentido para você.</em>
        </h2>
        <p class="diag-subtitle">
          Responda a 4 perguntas simples e receba um estudo preliminar de viabilidade diretamente com nossa equipe especializada, sem nenhum compromisso e com números 100% transparentes.
        </p>
      </header>

      <!-- Console Interativo (Grid Duplo: Formulário Guiado + HUD ao Vivo) -->
      <div class="diag-console">

        <!-- LADO ESQUERDO: Cartão Principal com Passos -->
        <div class="diag-main-card gb" data-spot data-blur-scroll id="diag-main-box">

          <!-- Barra de Progresso e Cabeçalho do Passo -->
          <div class="diag-step-header">
            <div class="diag-step-meta">
              <span class="diag-step-counter" id="diag-step-indicator">PASSO 01 DE 04</span>
              <span class="diag-step-pill-indicator" id="diag-step-status">OBJETIVO PRINCIPAL</span>
            </div>
            <div class="diag-progress-track">
              <div class="diag-progress-fill" id="diag-progress-fill" style="width: 25%;"></div>
            </div>
            <h3 class="diag-step-prompt" id="diag-step-prompt">Qual é o plano principal que você deseja colocar em prática?</h3>
            <p class="diag-step-desc" id="diag-step-desc">Selecione uma das frentes para direcionarmos as melhores tabelas conveniadas.</p>
          </div>

          <!-- ================= PASSO 1: OBJETIVO ================= -->
          <div class="diag-step-panel active" id="step-panel-1">
            <div class="diag-choice-grid">
              
              <div class="diag-choice-card selected" data-value="imoveis" data-target="step-1">
                <div class="diag-choice-top">
                  <div class="diag-choice-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                      <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                  </div>
                  <span class="diag-choice-check">✓</span>
                </div>
                <div>
                  <h4 class="diag-choice-title">Imóveis & Construção</h4>
                  <span class="diag-choice-tag">SFH · Aquisição · Construção · Terrenos</span>
                </div>
              </div>

              <div class="diag-choice-card" data-value="veiculos" data-target="step-1">
                <div class="diag-choice-top">
                  <div class="diag-choice-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.9 2 11.2 2 11.5V16c0 .6.4 1 1 1h2"/>
                      <circle cx="7" cy="17" r="2"/>
                      <path d="M9 17h6"/>
                      <circle cx="17" cy="17" r="2"/>
                    </svg>
                  </div>
                  <span class="diag-choice-check">✓</span>
                </div>
                <div>
                  <h4 class="diag-choice-title">Automóveis & Motos</h4>
                  <span class="diag-choice-tag">Zero Km · Seminovos · Utilitários</span>
                </div>
              </div>

              <div class="diag-choice-card" data-value="pesados" data-target="step-1">
                <div class="diag-choice-top">
                  <div class="diag-choice-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="3" width="15" height="13"/>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                  </div>
                  <span class="diag-choice-check">✓</span>
                </div>
                <div>
                  <h4 class="diag-choice-title">Pesados & Maquinário</h4>
                  <span class="diag-choice-tag">Caminhões · Agrícola · Plano 50%</span>
                </div>
              </div>

              <div class="diag-choice-card" data-value="patrimonio" data-target="step-1">
                <div class="diag-choice-top">
                  <div class="diag-choice-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="2" x2="12" y2="22"/>
                      <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                  </div>
                  <span class="diag-choice-check">✓</span>
                </div>
                <div>
                  <h4 class="diag-choice-title">Alavancagem Patrimonial</h4>
                  <span class="diag-choice-tag">Construção de Renda · Locação</span>
                </div>
              </div>

            </div>
          </div>

          <!-- ================= PASSO 2: VOLUME DE CRÉDITO ================= -->
          <div class="diag-step-panel" id="step-panel-2">
            <div class="diag-tier-grid" id="diag-tier-container">
              <!-- Renderizado dinamicamente via JavaScript conforme o objetivo -->
            </div>
          </div>

          <!-- ================= PASSO 3: HORIZONTE & ESTRATÉGIA ================= -->
          <div class="diag-step-panel" id="step-panel-3">
            <div class="diag-strategy-list">
              
              <div class="diag-strategy-card selected" data-value="curto" data-target="step-3">
                <div class="strat-badge-icon">⚡</div>
                <div class="strat-content">
                  <span class="strat-title">Aceleração / Curto Prazo (50 a 80 meses)</span>
                  <span class="strat-desc">Estratégia de contemplação planejada utilizando Lance Livre ou Lance Embutido de até 30% da própria carta para antecipar a conquista sem tirar recursos do bolso.</span>
                </div>
              </div>

              <div class="diag-strategy-card" data-value="medio" data-target="step-3">
                <div class="strat-badge-icon">⚖️</div>
                <div class="strat-content">
                  <span class="strat-title">Equilíbrio / Médio Prazo (90 a 165 meses)</span>
                  <span class="strat-desc">Oferta de Lance Fixo pré-determinado (25% a 50%) para concorrer em igualdade pela Loteria Federal, sem disputar com grandes lances.</span>
                </div>
              </div>

              <div class="diag-strategy-card" data-value="longo" data-target="step-3">
                <div class="strat-badge-icon">🛡️</div>
                <div class="strat-content">
                  <span class="strat-title">Disciplina / Longo Prazo (180 a 240 meses)</span>
                  <span class="strat-desc">Parcelas reduzidas no Plano Estendido de até 20 anos (menores que o aluguel) ou modalidade Plano 50% para pesados.</span>
                </div>
              </div>

            </div>
          </div>

          <!-- ================= PASSO 4: ORÇAMENTO & CAPTURA ================= -->
