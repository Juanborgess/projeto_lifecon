---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SolutionCard from '../components/SolutionCard.astro';
import ContrastCard from '../components/ContrastCard.astro';
import FaqItem from '../components/FaqItem.astro';
import PillarCard from '../components/PillarCard.astro';
import DiagnosticSection from '../components/DiagnosticSection.astro';
import HeroSection from '../components/HeroSection.astro';
import ClosingSection from '../components/ClosingSection.astro';
import { Image } from 'astro:assets';
import fotoRafael from '../assets/foto-rafael-borges.png';
---

<Layout>
<HeroSection />

  <!-- ================= SEÇÃO 02: AS SOLUÇÕES LIFECON & O CONTRASTE FINANCEIRO ================= -->
  <section class="sec-solutions" id="como-funciona">
    <div class="sec-container">
      
      <!-- Header Editorial da Seção -->
      <header class="sec-header" data-blur-scroll>
        <div class="sec-kicker">
          <span class="sec-kicker-dot"></span>
          <span>02 · ESTRUTURAÇÃO PATRIMONIAL</span>
        </div>
        <h2 class="sec-title">
          Não entregamos apenas cartas de crédito.<br>
          Estruturamos <em>caminhos viáveis</em> para o que você quer realizar.
        </h2>
        <p class="sec-subtitle">
          Conheça as três principais frentes de planejamento da Lifecon. Uma abordagem estratégica para quem busca solidez, poder de compra à vista e custo financeiro infinitamente menor.
        </p>
      </header>

      <!-- As Três Frentes Estratégicas (Grid Bento com Vidro .gb e Spotlight [data-spot]) -->
      <div class="solution-grid">
        
        <!-- Solução 1: Imóveis & Construção -->
        <SolutionCard
          id="imoveis"
          badgeNum="01 / 03"
          badgeTag="SFH & Imobiliário"
          title="Imóveis, Terrenos, Construção ou Reforma"
          description="Para quem quer sair do aluguel, adquirir um imóvel de maior padrão, construir do zero ou reformar sem comprometer o fluxo de caixa com juros bancários compostos."
          calloutLabel="Lance Embutido de até 30% + FGTS"
          calloutText="Utilize de 25% a até 30% da própria carta como oferta de lance sem desembolsar recursos próprios, além da possibilidade de uso integral do seu FGTS pelo SFH."
          specs={[
            "R$ 100k a R$ 1.2M+",
            "50 a 240 meses (até 20 anos)",
            "Taxa Adm a partir de 12% Total",
            "Opções com 0% Entrada",
            "Reajuste Oficial INCC"
          ]}
          actionText="Simular Plano Imobiliário"
          actionHref="#diagnostico"
        >
          <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#09AFC6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </SolutionCard>

        <!-- Solução 2: Veículos & Frotas -->
        <SolutionCard
          id="veiculos"
          badgeNum="02 / 03"
          badgeTag="Automotivo & Frotas"
          title="Automóveis, Motos e Renovação de Frotas"
          description="Troque de veículo no momento certo com poder de compra à vista para negociar até 15% de desconto, sem desvalorização acelerada por juros de financiamento."
          calloutLabel="0% Entrada ou Antecipada em 12x"
          calloutText="Tabelas com 0% de taxa antecipada ou entrada fracionada em até 12x (1,2%). Concorra por Lance Fixo (25% ou 50%) e Lance Embutido de 25%."
          specs={[
            "Autos: R$ 45k a R$ 180k",
            "Motos: R$ 15k a R$ 30k",
            "40 a 100 meses",
            "Taxa a partir de 13% Total",
            "Reajuste Oficial IPCA"
          ]}
          actionText="Simular Plano Veicular"
          actionHref="#diagnostico"
        >
          <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#CA9D63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 10.9 2 11.2 2 11.5V16c0 .6.4 1 1 1h2"/>
            <circle cx="7" cy="17" r="2"/>
            <path d="M9 17h6"/>
            <circle cx="17" cy="17" r="2"/>
          </svg>
        </SolutionCard>

        <!-- Solução 3: Alavancagem Patrimonial & Pesados -->
        <SolutionCard
          id="patrimonio"
          badgeNum="03 / 03"
          badgeTag="Pesados & Alavancagem"
          title="Caminhões, Pesados & Alavancagem"
          description="Para empresários, frotistas e investidores que utilizam o consórcio para multiplicar ativos, adquirir máquinas e caminhões com o menor custo do mercado."
          calloutLabel="Plano 50%: Pague Meia Parcela"
          calloutText="Exclusividade para pesados: pague apenas 50% da parcela até a contemplação, preservando o capital de giro da sua empresa para crescer sem dívidas caras."
          specs={[
            "Pesados: R$ 200k a R$ 700k+",
            "Prazo de 100 meses",
            "Taxa Total de 12% a 14% (~1,4% a.a.)",
            "Opções 0% Entrada",
            "Plano 50% Parcelinha"
          ]}
          actionText="Simular Alavancagem"
          actionHref="#diagnostico"
        >
          <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#A3E635" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="22"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </SolutionCard>

      </div>

      <!-- ================= O ARGUMENTO LÓGICO DE CONTRASTE FINANCEIRO ================= -->
      <div class="contrast-section">
        
        <div class="contrast-header" data-blur-scroll>
          <div class="contrast-kicker">
            <span>ANÁLISE COMPARATIVA DE CUSTO</span>
          </div>
          <h3 class="contrast-title">O Contraste Financeiro que os Bancos não Contam</h3>
          <p class="contrast-subtitle">
            Veja a diferença matemática entre comprometer anos com juros bancários compostos ou planejar sua conquista com inteligência e taxas a partir de 12% para todo o contrato.
          </p>
        </div>

        <div class="contrast-grid">
          
          <!-- Lado Negativo: Financiamento Bancário -->
          <ContrastCard
            variant="danger"
            badgeText="✕ Ineficiência de Capital"
            title="No Financiamento Bancário"
            punch="Você adquire 1 bem e no final pagou de 2 a 3 vezes o valor dele."
            metricCaption="Custo Real Final"
            metricVal="220% a 300% do valor (Você paga 2 a 3 bens)"
          >
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Juros Compostos de 10% a 14% ao Ano:</strong> Parcelas infladas que transferem sua riqueza para o banco em vez de construir seu patrimônio.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Entrada Obrigatória de 20% a 30%:</strong> Descapitalização pesada logo no início (R$ 60k a R$ 100k+), secando sua reserva de emergência.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Taxas Embutidas, TAC e Seguros:</strong> Venda casada de seguros obrigatórios e IOF encarecendo brutalmente o Custo Efetivo Total (CET).</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✕</span>
              <span><strong>Amortização Lenta:</strong> O bem perde valor de mercado com o tempo enquanto o saldo devedor permanece elevado nos primeiros anos.</span>
            </li>
          </ContrastCard>

          <!-- Lado Positivo: Planejamento Lifecon -->
          <ContrastCard
            variant="positive"
            badgeText="✓ Alta Eficiência Patrimonial"
            title="No Planejamento Lifecon"
            punch="Você compra à vista com poder de negociação e taxa administrativa diluída."
            metricCaption="Custo Real Final"
            metricVal="Apenas o bem + Taxa de 12% a 18% total (Zero juros)"
          >
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Taxa Administrativa Pré-Fixada (Sem Juros):</strong> Ao contrário do financiamento, onde você paga juros compostos que dobram a dívida, no consórcio existe apenas uma taxa de administração diluída ao longo de todo o plano — gerando uma economia de até 60% no custo final do seu bem.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Opções com 0% de Entrada:</strong> Alternativas que não exigem aporte inicial à vista, preservando seu capital de giro e sua reserva financeira rendendo com segurança.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Lance Embutido de até 30% da Carta:</strong> Utilize parte da própria carta de crédito contratada como oferta de lance para acelerar sua contemplação sem desembolsar recursos próprios.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Plano 50% para Preservar o Caixa:</strong> Modalidade estratégica para frotas e pesados que permite pagar meia parcela até a contemplação, mantendo o fluxo de caixa da empresa saudável.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Poder de Compra Blindado (INCC e IPCA):</strong> O crédito reajusta anualmente para acompanhar a valorização real de mercado, assegurando seu poder de compra à vista em qualquer época.</span>
            </li>
            <li class="contrast-item">
              <span class="contrast-icon">✓</span>
              <span><strong>Administradoras Líderes de Mercado:</strong> Planos estruturados através de referências nacionais consolidadas como <strong>Embracon</strong> e <strong>CNVW</strong> (Consórcio Nacional Volkswagen), associadas à ABAC e auditadas pelo Banco Central.</span>
            </li>
          </ContrastCard>

        </div>

      </div>

      <!-- Banner de Fechamento com CTA Aural Design System -->
      <div class="sec-cta-banner gb" data-spot data-blur-scroll>
        <div class="banner-text-side">
          <span class="banner-kicker">PRÓXIMO PASSO ESTRATÉGICO</span>
          <h3 class="banner-title">Pronto para transformar planos em conquistas concretas?</h3>
          <p class="banner-desc">
            Apresentamos um estudo de viabilidade gratuito e sem compromisso, cruzando as maiores administradoras do país com o seu momento financeiro.
          </p>
        </div>

        <Button href="#diagnostico" text="Quero Simular Meu Objetivo" />
      </div>

    </div>
  </section>

  <DiagnosticSection />

  <!-- ================= SEÇÃO 04: AUTORIDADE, HUMANIZAÇÃO & OS 4 PILARES ================= -->
  <section class="sec-authority" id="sobre">
    <div class="auth-container">

      <!-- Header Editorial da Seção -->
      <header class="auth-header" data-blur-scroll>
        <div class="auth-kicker">
          <span class="auth-kicker-dot"></span>
          <span>04 · LIDERANÇA & COMPROMISSO PESSOAL</span>
        </div>
        <h2 class="auth-title">
          Quem está por trás<br>
          <em>da Lifecon?</em>
        </h2>
        <p class="auth-subtitle">
          Antes de qualquer número, cota ou contrato, existe um nome, uma trajetória sólida e o compromisso ético inegociável de construir relacionamentos de longo prazo com você.
        </p>
      </header>

      <!-- Layout Dual de Alta Autoridade (Esquerda: Card Retrato Presidencial / Direita: Manifesto & 4 Pilares) -->
      <div class="auth-layout">

        <!-- LADO ESQUERDO: Retrato Executivo & Credenciais Pessoais -->
        <div class="auth-portrait-card gb" data-spot data-blur-scroll>
          
          <div class="portrait-image-wrapper">
            <Image
              src={fotoRafael}
              alt="Rafael Gomes Borges - Idealizador e Consultor Estratégico da Lifecon"
              class="portrait-photo"
              loading="lazy"
            />
            <div class="portrait-overlay-gradient"></div>
            
            <!-- Badge Flutuante de Verificação -->
            <div class="portrait-status-badge">
              <span class="status-live-dot"></span>
              <span>Atendimento Pessoal Direto</span>
            </div>
          </div>

          <div class="portrait-info-block">
            <div class="portrait-names">
              <h3 class="portrait-name">Rafael Gomes Borges</h3>
              <span class="portrait-role">Idealizador & Consultor Patrimonial · Lifecon</span>
            </div>

            <!-- Chips de Credenciais & Integridade -->
            <div class="portrait-chips">
              <span class="auth-chip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                +10 Anos de Mercado
              </span>
              <span class="auth-chip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                Homologado BACEN · ABAC
              </span>
              <span class="auth-chip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                Zero Promessas Irreais
              </span>
            </div>

            <p class="portrait-bio-short">
              Especialista em alavancagem de cartas de crédito e estruturação estratégica para quem deseja construir patrimônio seguro, sem pagar juros bancários.
            </p>

            <!-- CTA Direto com o Rafael via WhatsApp -->
            <Button
              href="https://wa.me/5521972838954?text=Ol%C3%A1%2C%20Rafael%21%20Conheci%20a%20Lifecon%20pelo%20site%20e%20gostaria%20de%20conversar%20diretamente%20com%20voc%C3%AA%20sobre%20o%20meu%20planejamento."
              target="_blank"
              class="btn-portrait-cta"
              text="Falar com o Rafael no WhatsApp"
            />
          </div>

        </div>

        <!-- LADO DIREITO: Carta Aberta + Os 4 Pilares Inegociáveis -->
        <div class="auth-content-side">

          <!-- Carta Aberta do Fundador -->
          <div class="auth-letter-card gb" data-spot data-blur-scroll>
            <div class="letter-top-meta">
              <span class="letter-kicker">CARTA ABERTA AOS NOSSOS CLIENTES</span>
              <div class="quote-sign" aria-hidden="true">“</div>
            </div>

            <div class="letter-body">
              <p class="letter-lead">
                Ao longo de anos atuando na área comercial e financeira, vi de perto como o mercado muitas vezes trata as pessoas apenas como <em>números de contrato</em> para bater metas corporativas.
              </p>
              
              <p>
                No segmento de consórcios, isso se torna ainda mais delicado: promessas milagrosas de contemplação rápida e discursos agressivos de venda acabam gerando desilusão em quem só queria planejar a vida com segurança.
              </p>

              <blockquote class="letter-pullquote">
                <span>"A Lifecon nasceu para ser o contraponto absoluto disso. Nosso papel não é empurrar uma cota; nosso compromisso é sentar com você, entender a sua realidade de caixa e caminhar lado a lado até a entrega da sua chave."</span>
              </blockquote>

              <p>
                Aqui, a sua confiança é tratada com o respeito que ela merece. Antes de vender qualquer plano, queremos entender profundamente o seu.
              </p>
            </div>

            <!-- Bloco de Assinatura Institucional -->
            <div class="letter-signature-strip">
              <div class="signature-details">
                <span class="signature-name">Rafael Gomes Borges</span>
                <span class="signature-title">Fundador & Consultor Patrimonial · Lifecon</span>
              </div>
              <div class="signature-badge">
                <span class="sig-seal-dot"></span>
                <span>Compromisso Ético Registrado</span>
              </div>
            </div>
          </div>

          <!-- Os 4 Pilares Inegociáveis (Micro-Bento 2x2) -->
          <div class="auth-pillars-block" data-blur-scroll>
            <div class="pillars-header">
              <h4 class="pillars-title">Os 4 Pilares Inegociáveis da Lifecon</h4>
              <span class="pillars-subtitle">Diretrizes obrigatórias que regem cada simulação, cota e atendimento prestado:</span>
            </div>

            <div class="pillars-grid">
              
              <!-- Pilar 1 -->
              <PillarCard
                num="01"
                glow="gold"
                tag="Ética Absoluta"
                title="Transparência Radical"
                description="Toda taxa administrativa, fundo de reserva, seguro e histórico real de assembleias são apresentados na mesa antes de qualquer assinatura. Sem entrelinhas ou surpresas."
              />

              <!-- Pilar 2 -->
              <PillarCard
                num="02"
                glow="cyan"
                tag="Saúde de Caixa"
                title="Planejamento Antes da Venda"
                description="Analisamos sua renda familiar e capacidade real de aporte. Se o plano comprometer sua reserva ou não fizer sentido matemático para os próximos anos, nós não o recomendamos."
              />

              <!-- Pilar 3 -->
              <PillarCard
                num="03"
                glow="gold"
                tag="Sem Robôs"
                title="Proximidade Real"
                description="Você não fala com centrais terceirizadas nem atendentes robotizados. Você tem acesso direto ao especialista que conhece a sua história, o seu objetivo e o seu nome."
              />

              <!-- Pilar 4 -->
              <PillarCard
                num="04"
                glow="cyan"
                tag="Fim a Fim"
                title="Acompanhamento Contínuo"
                description="Nossa relação começa no contrato e continua mensalmente: orientamos estratégias de Lances Livres, Fixos e Embutidos de até 30%, além de suporte documental integral no faturamento."
              />

            </div>
          </div>

        </div>

      </div>

      <!-- Banner Institucional de Garantia e Parcerias Homologadas -->
      <div class="auth-compliance-banner gb" data-spot data-blur-scroll>
        <div class="compliance-left">
          <div class="compliance-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div>
            <h4 class="compliance-title">Segurança Institucional & Fiscalização Governamental</h4>
            <p class="compliance-desc">
              Todas as cartas comercializadas pela Lifecon são emitidas por administradoras homologadas e auditadas diretamente pelo Banco Central do Brasil (BACEN) e fiscalizadas pela Associação Brasileira de Administradoras de Consórcios (ABAC).
            </p>
          </div>
        </div>

        <div class="compliance-partners">
          <span class="partner-badge">Embracon</span>
          <span class="partner-badge">CNVW</span>
          <span class="partner-badge">Associadas ABAC</span>
          <span class="partner-badge">Normas BACEN</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= SEÇÃO 05: A CENTRAL DE CLAREZA (FAQ INTERATIVO) ================= -->
  <section class="sec-faq" id="faq">
    <div class="faq-container">

      <!-- Header Editorial da Seção -->
      <header class="faq-header" data-blur-scroll>
        <div class="faq-kicker">
          <span class="faq-kicker-dot"></span>
          <span>05 · CENTRAL DE CLAREZA & DESMISTIFICAÇÃO</span>
        </div>
        <h2 class="faq-title">
          A verdade sobre consórcio,<br>
          <em>sem meias palavras.</em>
        </h2>
        <p class="faq-subtitle">
          Tire suas dúvidas com quem joga limpo sobre regras, prazos, lances e funcionamento real. Sem enrolação de vendedor, com a transparência de quem joga limpo pelo seu patrimônio.
        </p>
      </header>

      <!-- Barra de Filtros Interativos por Categoria -->
      <div class="faq-filter-bar" data-blur-scroll role="tablist" aria-label="Filtrar dúvidas por assunto">
        <button type="button" class="faq-filter-btn active" data-filter="all">
          <span>Todas as Dúvidas</span>
          <span class="faq-filter-count">(7)</span>
        </button>
        <button type="button" class="faq-filter-btn" data-filter="lances">
          <span>Lances & Contemplação</span>
          <span class="faq-filter-count">(3)</span>
        </button>
        <button type="button" class="faq-filter-btn" data-filter="custos">
          <span>Taxas & Parcelas</span>
          <span class="faq-filter-count">(2)</span>
        </button>
        <button type="button" class="faq-filter-btn" data-filter="seguranca">
          <span>Segurança & Regras</span>
          <span class="faq-filter-count">(2)</span>
        </button>
      </div>

      <!-- Lista dos 7 Cards de Accordion -->
      <div class="faq-list" id="faq-accordion-list">

        <!-- FAQ 1 -->
        <FaqItem
          num="01"
          categoryTag="Segurança Regulatória & BACEN"
          category="seguranca"
          question="A Lifecon garante que serei contemplado rapidamente ou em data fixa?"
          isActive={true}
          takeawayTitle="Regra de Ouro"
          takeawayText="Promessa de cota contemplada com data certa é fraude. Na Lifecon, trabalhamos com probabilidade estatística, histórico real e transparência radical."
        >
          <p>
            <strong>Nunca.</strong> Desconfie imediatamente de qualquer empresa, vendedor ou corretor que prometa contemplação com prazo garantido — essa prática é expressamente proibida pelo Banco Central do Brasil e pode constituir golpe financeiro.
          </p>
          <p>
            No sistema de consórcios regulamentado, as contemplações ocorrem exclusivamente por <strong>Sorteio</strong> e por <strong>Lances</strong> nas assembleias mensais. O papel da assessoria Lifecon é analisar a fundo o histórico de lances do grupo para traçar estratégias matemáticas coerentes com a sua disponibilidade de aporte.
          </p>
        </FaqItem>

        <!-- FAQ 2 -->
        <FaqItem
          num="02"
          categoryTag="Estratégia de Lances & Alavancagem"
          category="lances"
          question="Como funciona a oferta de lances para antecipar a compra? Preciso ter dinheiro em mãos?"
          takeawayTitle="Estratégia Lifecon"
          takeawayText="Você pode combinar Lance Embutido com recursos próprios ou FGTS para turbinar sua oferta sem asfixiar seu caixa pessoal."
        >
          <p>
            <strong>Não necessariamente!</strong> Essa é uma das maiores vantagens estratégicas do consórcio moderno trabalhado pela Lifecon. Além do Lance Livre tradicional (onde quem oferta o maior percentual com recursos próprios vence), atuamos com duas modalidades fundamentais:
          </p>
          <p>
            <strong>1. Lance Embutido (25% a 30%):</strong> Você pode utilizar de 25% a 30% do próprio crédito contratado para compor seu lance. Ou seja, você antecipa sua contemplação sem precisar desembolsar dinheiro vivo na largada.
          </p>
          <p>
