  <!-- ================= MOTOR GSAP & CANVAS FRAME SEQUENCE SCRUBBING ================= -->
  <script is:inline>
    (function () {
      'use strict';

      // 1. Registro dos Plugins GSAP
      gsap.registerPlugin(ScrollTrigger);

      // 2. Elementos DOM
      var canvas = document.getElementById('hero-canvas');
      var ctx = canvas.getContext('2d', { alpha: false });
      var textLayer = document.getElementById('hero-text-layer');
      var scrimOverlay = document.getElementById('hero-scrim');
      var scrollCue = document.getElementById('hero-scroll-cue');

      // 3. Configurações da Sequência de Quadros
      var TOTAL_FRAMES = 120;
      var isMobile = window.innerWidth < 992;
      var framesPath = isMobile ? '/assets/frames-mobile/' : '/assets/frames-desktop/';
      
      var images = [];
      var currentFrameIndex = 0;
      var isFirstFrameRendered = false;

      // Formata índice: 0 -> "frame_0000.webp"
      function getFrameFileName(index) {
        var str = index.toString();
        while (str.length < 4) str = '0' + str;
        return framesPath + 'frame_' + str + '.webp';
      }

      // Redimensionamento Otimizado do Canvas
      function resizeCanvas() {
        var rect = canvas.getBoundingClientRect();
        // Clamping de DPR: 1.5 no mobile e 2 no desktop (elimina exaustão de GPU em celulares modestos)
        var dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2);
        
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);

        if (ctx) {
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = isMobile ? 'medium' : 'high';
        }

        renderFrame(currentFrameIndex);
      }

      // Renderiza Quadro com object-fit: cover perfeito e zero flicker
      function renderFrame(index) {
        if (!ctx || !canvas.width || !canvas.height) return;

        // Se o quadro específico ainda estiver em trânsito de download, usa o quadro carregado mais próximo
        var targetImg = images[index];
        if (!targetImg || !targetImg.complete || targetImg.naturalWidth === 0) {
          // Busca para trás
          var found = false;
          for (var i = index - 1; i >= 0; i--) {
            if (images[i] && images[i].complete && images[i].naturalWidth !== 0) {
              targetImg = images[i];
              found = true;
              break;
            }
          }
          if (!found) {
            // Busca para frente
            for (var j = index + 1; j < TOTAL_FRAMES; j++) {
              if (images[j] && images[j].complete && images[j].naturalWidth !== 0) {
                targetImg = images[j];
                break;
              }
            }
          }
        }

        if (!targetImg || !targetImg.complete || targetImg.naturalWidth === 0) return;

        currentFrameIndex = index;

        var cw = canvas.width;
        var ch = canvas.height;
        var iw = targetImg.naturalWidth;
        var ih = targetImg.naturalHeight;

        // ================= OBJECT-FIT INTELIGENTE NO MOBILE =================
        // No mobile: as telas modernas (19.5:9) são mais estreitas que a proporção 9:16 do vídeo.
        // O logotipo "LIFECON" e "CONSÓRCIOS • PLANEJAMENTO • PATRIMÔNIO" ocupam quase toda a largura (920px de 1080px).
        // Portanto, fixamos a escala mobile rigorosamente em (cw / iw) para garantir que
        // NENHUMA letra de "LIFECON" ou dos subtítulos seja cortada nas bordas em qualquer celular.
        var scale = isMobile 
          ? (cw / iw)
          : Math.max(cw / iw, ch / ih);

        var nw = Math.round(iw * scale);
        var nh = Math.round(ih * scale);

        // Centralização horizontal absoluta: no mobile nx = 0 (100% de largura visível sem corte)
        var nx = Math.round((cw - nw) / 2);

        // Ajuste vertical: centraliza perfeitamente no viewport
        var ny = isMobile 
          ? Math.round((ch - nh) / 2)
          : ((nh > ch) ? Math.round((ch - nh) * 0.30) : Math.round((ch - nh) / 2));

        // Preenche o fundo para transição sem emenda caso nh < ch
        if (isMobile && nh < ch) {
          ctx.fillStyle = '#000c22';
          ctx.fillRect(0, 0, cw, ch);
        }

        // Renderiza o frame no canvas com aceleração direta por GPU
        ctx.drawImage(targetImg, nx, ny, nw, nh);
      }

      // Pré-carregamento Inteligente e Prioritário (Zero Race Conditions)
      function preloadFrames() {
        // Inicializa o array de instâncias Image
        for (var i = 0; i < TOTAL_FRAMES; i++) {
          images[i] = new Image();
        }

        // PRIORIDADE 1: Quadro 0 (garante renderização imediata, mesmo se em cache)
        var img0 = images[0];
        img0.onload = function () {
          isFirstFrameRendered = true;
          resizeCanvas();
          renderFrame(0);
        };
        img0.src = getFrameFileName(0);
        if (img0.complete && img0.naturalWidth !== 0) {
          img0.onload();
        }

        // PRIORIDADE 2: Quadros 1 a 20 (área inicial de scroll)
        for (var k = 1; k <= 20 && k < TOTAL_FRAMES; k++) {
          (function (idx) {
            var img = images[idx];
            img.onload = function () {
              if (currentFrameIndex === idx) {
                renderFrame(idx);
              }
            };
            img.src = getFrameFileName(idx);
          })(k);
        }

        // PRIORIDADE 3: Restante dos quadros em lotes não-bloqueantes
        var nextBatchStart = 21;
        function loadBatch() {
          var batchSize = isMobile ? 12 : 24;
          var end = Math.min(nextBatchStart + batchSize, TOTAL_FRAMES);
          for (var idx = nextBatchStart; idx < end; idx++) {
            (function (index) {
              var img = images[index];
              img.onload = function () {
                if (currentFrameIndex === index) {
                  renderFrame(index);
                }
              };
              img.src = getFrameFileName(index);
            })(idx);
          }
          nextBatchStart = end;
          if (nextBatchStart < TOTAL_FRAMES) {
            if (window.requestIdleCallback) {
              window.requestIdleCallback(loadBatch, { timeout: 150 });
            } else {
              setTimeout(loadBatch, 30);
            }
          }
        }

        setTimeout(loadBatch, 60);
      }

      // Animação de Entrada
      function playEntranceAnimation() {
        var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

        tl.from('#hd', {
          y: -40,
          opacity: 0,
          duration: 1.1
        });

        tl.from('.hero-anim-elem', {
          y: 40,
          opacity: 0,
          duration: 1.2,
          stagger: 0.12
        }, '-=0.7');

        var floatBadges = document.getElementById('hero-float-badges');
        if (floatBadges) {
          tl.from(floatBadges.querySelectorAll('.hero-float-card'), {
            scale: 0.75,
            opacity: 0,
            duration: 0.9,
            stagger: 0.15,
            ease: 'back.out(1.5)'
          }, '-=0.5');
        }

        var bottomDock = document.getElementById('hero-bottom-dock');
        if (bottomDock) {
          tl.from(bottomDock, {
            opacity: 0,
            y: 20,
            duration: 0.8
          }, '-=0.4');
        }

        tl.from(scrollCue, {
          opacity: 0,
          duration: 0.8
        }, '-=0.3');
      }

      // Configuração Scrollytelling via ScrollTrigger
      function setupScrollytelling() {
        var frameState = { frame: 0 };
        var floatBadges = document.getElementById('hero-float-badges');
        var bottomDock = document.getElementById('hero-bottom-dock');

        // Master Timeline acoplada ao ScrollTrigger com scrub ultra fluído e sem gargalo de decodificador
        var masterTl = gsap.timeline({
          scrollTrigger: {
            trigger: '#hero-scroll-wrapper',
            pin: '#hero-pin-target',
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.15, // Micro-inércia líquida 60/120fps como no ecossistema Apple
            anticipatePin: 1
          }
        });

        // 1. Interpolação contínua dos 120 quadros
        masterTl.to(frameState, {
          frame: TOTAL_FRAMES - 1,
          ease: 'none',
          duration: 1,
          onUpdate: function () {
            var targetIndex = Math.round(frameState.frame);
            if (targetIndex !== currentFrameIndex && targetIndex < TOTAL_FRAMES) {
              renderFrame(targetIndex);
            }
          }
        }, 0);

        // 2. Fade out suave do texto e scrim nos primeiros 20% do scroll
        masterTl.to(textLayer, {
          opacity: 0,
          y: -36,
          filter: 'blur(8px)',
          pointerEvents: 'none',
          ease: 'power2.inOut',
          duration: 0.20
        }, 0);

        masterTl.to(scrimOverlay, {
          opacity: 0,
          ease: 'power2.inOut',
          duration: 0.20
        }, 0);

        if (floatBadges) {
          masterTl.to(floatBadges, {
            opacity: 0,
            y: -18,
            ease: 'power2.inOut',
            duration: 0.18
          }, 0);
        }

        if (bottomDock) {
          masterTl.to(bottomDock, {
            opacity: 0,
            ease: 'power1.out',
            duration: 0.12
          }, 0);
        }

        masterTl.to(scrollCue, {
          opacity: 0,
          ease: 'power1.out',
          duration: 0.10
        }, 0);
      }

      // ================= ANIMAÇÕES BI-DIRECIONAIS DE BLUR IN / BLUR OUT (AURAL + APPLE GRADE) =================
      function setupBlurScrollAnimations() {
        var blurElements = document.querySelectorAll('[data-blur-scroll]');
        if (!blurElements.length) return;

        blurElements.forEach(function (el) {
          // Estado inicial: desfocado e deslocado suavemente
          gsap.set(el, {
            opacity: 0,
            filter: 'blur(14px)',
            y: 35
          });

          ScrollTrigger.create({
            trigger: el,
            start: 'top 88%',
            end: 'bottom 12%',
            onEnter: function () {
              // Entrando por baixo ao rolar para baixo: Blur In suave para nitidez
              gsap.to(el, {
                opacity: 1,
                filter: 'blur(0px)',
                y: 0,
                duration: 0.85,
                ease: 'power3.out',
                overwrite: 'auto'
              });
            },
            onLeave: function () {
              // Saindo pelo topo ao continuar rolando para baixo: Blur Out suave para cima
              gsap.to(el, {
                opacity: 0,
                filter: 'blur(14px)',
                y: -35,
                duration: 0.65,
                ease: 'power2.in',
                overwrite: 'auto'
              });
            },
            onEnterBack: function () {
              // Retornando pelo topo ao rolar para cima: Reaparece com Blur In suave para nitidez
              gsap.to(el, {
                opacity: 1,
                filter: 'blur(0px)',
                y: 0,
                duration: 0.85,
                ease: 'power3.out',
                overwrite: 'auto'
              });
            },
            onLeaveBack: function () {
              // Saindo por baixo ao rolar para cima: Blur Out suave para baixo
              gsap.to(el, {
                opacity: 0,
                filter: 'blur(14px)',
                y: 35,
                duration: 0.65,
                ease: 'power2.in',
                overwrite: 'auto'
              });
            }
          });
        });
      }

      // ================= TRACKING DE SPOTLIGHT INTERATIVO [data-spot] (AURAL SYSTEM - OTIMIZADO) =================
      function setupSpotlightTracking() {
        // Dispositivos touch (mobile) não possuem cursor hover — economiza ciclos de CPU e bateria
        if (window.matchMedia && !window.matchMedia('(pointer: fine)').matches) return;

        var spotCards = document.querySelectorAll('[data-spot]');
        spotCards.forEach(function (card) {
          var ticking = false;
          card.addEventListener('mousemove', function (e) {
            if (!ticking) {
              window.requestAnimationFrame(function () {
                var rect = card.getBoundingClientRect();
                var x = e.clientX - rect.left;
                var y = e.clientY - rect.top;
                card.style.setProperty('--mx', x + 'px');
                card.style.setProperty('--my', y + 'px');
                ticking = false;
              });
              ticking = true;
            }
          }, { passive: true });
        });
      }

