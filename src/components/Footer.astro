---
// Footer.astro - Rodapé Institucional Lifecon
import { Image } from 'astro:assets';
import logoLifecon from '../assets/logo-lifecon.jpeg';
---

<footer class="site-footer" transition:persist>
  <div class="footer-container">
    
    <div class="footer-main-grid" data-blur-scroll>
      
      <!-- Coluna 1: Marca & Propósito -->
      <div class="footer-brand-side">
        <a href="#hero-scroll-wrapper" class="footer-logo" aria-label="Lifecon - Início">
          <Image src={logoLifecon} alt="Símbolo Lifecon" />
          <span class="footer-logo-text">
            <span class="brand-life">Life</span><span class="brand-con">con</span>
          </span>
        </a>
        <p class="footer-slogan">"A vida é feita de planos."</p>
        <p class="footer-desc">
          Consultoria patrimonial ética e especializada. Estruturamos caminhos viáveis para a conquista de imóveis, veículos e expansão de frotas com transparência radical.
        </p>
      </div>

      <!-- Coluna 2: Soluções -->
      <div>
        <h4 class="footer-col-title">Soluções</h4>
        <ul class="footer-nav-list">
          <li><a href="#imoveis" class="footer-nav-link">Imóveis & Construção</a></li>
          <li><a href="#veiculos" class="footer-nav-link">Automóveis & Veículos</a></li>
          <li><a href="#patrimonio" class="footer-nav-link">Pesados & Maquinário</a></li>
          <li><a href="#patrimonio" class="footer-nav-link">Alavancagem Patrimonial</a></li>
          <li><a href="#diagnostico" class="footer-nav-link">Simulação Guiada</a></li>
        </ul>
      </div>

      <!-- Coluna 3: Navegação Institucional -->
      <div>
        <h4 class="footer-col-title">Institucional</h4>
        <ul class="footer-nav-list">
          <li><a href="#hero-scroll-wrapper" class="footer-nav-link">Início</a></li>
          <li><a href="#como-funciona" class="footer-nav-link">Como Funciona</a></li>
          <li><a href="#sobre" class="footer-nav-link">Sobre o Rafael Borges</a></li>
          <li><a href="#faq" class="footer-nav-link">Central de Clareza (FAQ)</a></li>
          <li><a href="#contato" class="footer-nav-link">Fale Conosco</a></li>
        </ul>
      </div>

      <!-- Coluna 4: Contato & Homologação -->
      <div>
        <h4 class="footer-col-title">Contato & Parceiras</h4>
        <div class="footer-contact-block">
          <a href="https://wa.me/5521972838954" target="_blank" rel="noopener noreferrer" class="footer-contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>+55 (21) 97283-8954</span>
          </a>

          <div class="footer-contact-item" style="cursor: default;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Seg a Sex · 08h às 19h</span>
          </div>

          <div class="footer-contact-item" style="cursor: default;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Rio de Janeiro - RJ · Brasil</span>
          </div>
        </div>

        <div class="footer-admin-tags">
          <span class="partner-badge" style="font-size: 11px;">Embracon</span>
          <span class="partner-badge" style="font-size: 11px;">CNVW</span>
        </div>
      </div>

    </div>

    <!-- Barra Inferior de Direitos e Legal -->
    <div class="footer-sub-row" data-blur-scroll>
      <div>
        © 2026 Lifecon Planejamento Patrimonial e Consórcios. Todos os direitos reservados.
      </div>

      <div class="footer-legal-links">
        <a href="#">Termos de Uso</a>
        <span>•</span>
        <a href="#">Política de Privacidade (LGPD)</a>
        <span>•</span>
        <a href="#">Governança Ética</a>
      </div>

      <a href="#hero-scroll-wrapper" class="footer-back-to-top" aria-label="Voltar ao início da página">
        <span>Voltar ao Topo</span>
        <span>↑</span>
      </a>
    </div>

  </div>
</footer>
