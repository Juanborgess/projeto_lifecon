---
// Header.astro - Cabeçalho / Navbar Superior Lifecon
import Button from './Button.astro';
import { Image } from 'astro:assets';
import logoLifecon from '../assets/logo-lifecon.jpeg';
---

<header id="hd" transition:persist>
  <a href="#hero-scroll-wrapper" class="hd-brand" aria-label="Lifecon - Início">
    <Image
      src={logoLifecon}
      alt="Símbolo Lifecon"
      class="hd-brand-icon"
      loading="eager"
      fetchpriority="high"
    />
    <span class="hd-brand-text">
      <span class="brand-life">Life</span><span class="brand-con">con</span>
    </span>
  </a>

  <nav class="hd-nav gb" aria-label="Navegação Principal">
    <a href="#imoveis">Imóveis</a>
    <a href="#veiculos">Veículos</a>
    <a href="#patrimonio">Patrimônio</a>
    <a href="#como-funciona">Como Funciona</a>
    <a href="#sobre">Sobre</a>
    <a href="#faq">Dúvidas</a>
    <a href="#contato">Contato</a>
  </nav>

  <div class="hd-actions">
    <Button href="#diagnostico" size="sm" id="nav-cta-btn" text="Simule seu Plano" />
  </div>
</header>
